# Copiá este archivo como .env.local y completá los valores.
# .env.local no se commitea nunca.

# ─────────────────────────────────────────────────────────────────────────────
# Cesión de derechos de imagen — /cesion
# ─────────────────────────────────────────────────────────────────────────────
# Supabase: base donde quedan registradas las firmas.
# URL del proyecto, con la forma https://xxxxxxxx.supabase.co
SUPABASE_URL=

# service_role key (Settings > API). Ignora las políticas RLS, así que solo
# vive del lado servidor: nunca con prefijo NEXT_PUBLIC_, nunca en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Sal del hash de IP. Cualquier cadena larga y aleatoria; si cambia, los hashes
# viejos dejan de ser comparables con los nuevos, así que se define una vez.
IP_HASH_SALT=

# ─────────────────────────────────────────────────────────────────────────────
# EmailJS — Follow Fest Form
# ─────────────────────────────────────────────────────────────────────────────
# Obtené estas credenciales en https://www.emailjs.com/
NEXT_PUBLIC_EMAILJS_SERVICE_ID=tu_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=tu_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=tu_public_key
